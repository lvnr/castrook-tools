{
  "name": "castrook-tools",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Public Castrook SDKs, CLI, integration skills and machine-readable API guides",
  "workspaces": ["packages/castrook-sdk"],
  "scripts": {
    "build": "npm run build --workspace castrook",
    "test": "vitest run",
    "check": "node scripts/local-release.mjs check",
    "release:prepare": "node scripts/local-release.mjs prepare",
    "release:verify": "node scripts/local-release.mjs verify",
    "pack": "npm run release:prepare"
  },
  "devDependencies": { "vitest": "4.1.11" }
}
